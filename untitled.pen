                                        {
                                          "type": "text",
                                          "id": "bxvpb",
                                          "name": "Tabby self-hosts code completion compete",
                                          "context": "p",
                                          "fill": "#9aa0ab",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 147,
                                          "content": "Tabby self-hosts code completion competently — on a GPU you have to rent or own. $10/mo buys frontier-model completions; a capable inference GPU runs multiples of that in electricity alone. The math inverts only if idle GPU hardware already exists in your house.",
                                          "lineHeight": 1.6,
                                          "fontFamily": "Plus Jakarta Sans Variable",
                                          "fontSize": 13.12,
                                          "fontWeight": "normal"
                                        }
