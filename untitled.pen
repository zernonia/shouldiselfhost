                          "id": "DWiV6",
                          "name": "Frank",
                          "fill": "$text-1",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Fifty-one panels of the hundred keep their verdict at every labour rate between zero and sixty dollars an hour. Forty-nine do not.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-body",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "QusxU",
                          "name": "Frank Body",
                          "fill": "$text-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "That is the honest limit of this standard. On roughly half the roll the verdict is a statement about the price of your evening rather than about the software, and at $22 an hour we are being generous to self-hosting, not hostile to it. If your time is worth more than that, read every KINDA as a NOT REALLY and check the hours line before you believe anything else on the panel.",
                          "lineHeight": 1.62,
                          "fontFamily": "$font-body",
                          "fontSize": 12.5,
                          "fontWeight": "normal"
                        }
