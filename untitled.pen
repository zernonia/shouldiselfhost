                                        {
                                          "type": "text",
                                          "id": "n7MEWr",
                                          "name": "Buffer's $5/channel is cheap, and the re",
                                          "context": "p",
                                          "fill": "#9aa0ab",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 126,
                                          "content": "Buffer's $5/channel is cheap, and the real cost of Postiz (fine software) is maintenance: every social network rotates tokens and breaks APIs on their schedule, making your scheduler a part-time job. The subscription outsources exactly the annoying part.",
                                          "lineHeight": 1.6,
                                          "fontFamily": "Plus Jakarta Sans Variable",
