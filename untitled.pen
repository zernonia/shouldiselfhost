                                        {
                                          "type": "text",
                                          "id": "i1Zzo",
                                          "name": "PhotoPrism and Immich organize and searc",
                                          "context": "p",
                                          "fill": "#9aa0ab",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 147,
                                          "content": "PhotoPrism and Immich organize and search photos brilliantly. Neither develops a RAW file. Lightroom's $9.99 plan is an editor with a catalog attached — replace the catalog and you still need the editor, so the subscription survives. Darktable is free and local but it's a different app, not a self-hosted service.",
                                          "lineHeight": 1.6,
                                          "fontFamily": "Plus Jakarta Sans Variable",
                                          "fontSize": 13.12,
                                          "fontWeight": "normal"
