{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shouldiselfhost",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "shouldiselfhost.com", "custom_domain": true },
    { "pattern": "www.shouldiselfhost.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shouldiselfhost-votes",
      "database_id": "1607b4dd-f122-4550-a518-57fd73752733"
    }
  ]
}
